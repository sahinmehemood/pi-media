+/* ── Librarian: channel rows (allowlist + types) + pairing token ─────── */
+const LIBRARIAN_CHANNEL_TYPES = ['movie', 'tv', 'anime', 'donghua', 'cartoon', 'drama', 'ova', 'special', 'unknown'];
+
+function librarianChannelTypeRowHTML(channel, type) {
+    const opts = LIBRARIAN_CHANNEL_TYPES.map(t =>
+        `<option value="${t}" ${t === type ? 'selected' : ''}>${t}</option>`).join('');
+    return `
+        <input type="text" class="s-input lct-channel" value="${escapeHtmlAttr(channel || '')}" placeholder="-100xxxxxxxxxx" style="flex:1">
+        <select class="s-input lct-type" style="flex:0 0 9rem">${opts}</select>
+        <button type="button" class="remove-btn" onclick="removeLibrarianChannelTypeRow(this)" title="Remove">
+            <i class="fa-solid fa-xmark"></i>
+        </button>
+    `;
+}
+
+function addLibrarianChannelTypeRow(channel, type) {
+    const container = document.getElementById('librarian_channel_types_rows');
+    if (!container) return;
+    const row = document.createElement('div');
+    row.className = 'lct-row';
+    row.style.cssText = 'display:flex;gap:0.5rem;margin-bottom:0.4rem';
+    row.innerHTML = librarianChannelTypeRowHTML(channel || '', type || 'unknown');
+    container.appendChild(row);
+    const input = row.querySelector('.lct-channel');
+    if (input && !channel) input.focus();
+}
+
+function removeLibrarianChannelTypeRow(btn) {
+    const row = btn.closest('.lct-row');
+    if (row) row.remove();
+}
+
+function collectLibrarianChannels() {
+    const out = [];
+    document.querySelectorAll('#librarian_channel_types_rows .lct-row').forEach(row => {
+        const chEl = row.querySelector('.lct-channel');
+        if (!chEl) return;
+        const ch = extractChannelId(chEl.value);
+        if (ch) out.push(ch);
+    });
+    return out;
+}
+
+function addLibrarianChannelRow() {
+    const newInput = document.getElementById('librarian_channels_new');
+    if (!newInput) return;
+    const value = newInput.value.trim();
+    if (!value) return;
+    if (!isValidChannelId(value)) {
+        alert('Only channel IDs in -100xxxxxxxxxx format are accepted (channels only).');
+        return;
+    }
+    if (collectLibrarianChannels().includes(value)) {
+        alert('This channel is already added.');
+        return;
+    }
+    addLibrarianChannelTypeRow(value, 'unknown');
+    newInput.value = '';
+    newInput.focus();
+}
+
+function collectLibrarianChannelTypes() {
+    const out = {};
+    document.querySelectorAll('#librarian_channel_types_rows .lct-row').forEach(row => {
+        const chEl = row.querySelector('.lct-channel');
+        const tpEl = row.querySelector('.lct-type');
+        if (!chEl || !tpEl) return;
+        const ch = extractChannelId(chEl.value);
+        const tp = tpEl.value;
+        if (!ch) return;
+        // Absent means unknown: a row still set to unknown stores no
+        // type entry — the map holds only explicit types.
+        if (tp === 'unknown') return;
+        out[ch] = tp;
+    });
+    return out;
+}
+
+function rebuildLibrarianChannelTypes(types, channels) {
+    const container = document.getElementById('librarian_channel_types_rows');
+    if (!container) return;
+    types = types || {};
+    container.innerHTML = '';
+    (channels || []).forEach(ch => {
+        addLibrarianChannelTypeRow(String(ch), types[String(ch)] || 'unknown');
+    });
+}
+
+async function generateLibrarianToken() {
+    const btn = document.getElementById('librarian-token-generate');
+    const msg = document.getElementById('librarian-token-msg');
+    if (!btn) return;
+    btn.disabled = true;
+    try {
+        const res = await fetch('/admin/librarian/token/generate', { method: 'POST' });
+        const data = await res.json().catch(() => ({}));
+        if (!res.ok) throw new Error(data.detail || data.error || 'Token generation failed.');
+        const input = document.getElementById('librarian-token-once');
+        input.value = data.token || '';
+        document.getElementById('librarian-token-once-wrap').style.display = '';
+        document.getElementById('librarian-token-warn').textContent =
+            data.message || 'Store this token in the Media Manager profile\u2019s secrets now \u2014 it is shown once and cannot be retrieved again.';
+        msg.style.display = 'none';
+        const status = document.getElementById('librarian-token-status');
+        if (status) status.textContent = 'Set';
+        btn.textContent = 'Rotate token';
+        input.select();
+    } catch (e) {
+        msg.style.display = '';
+        msg.style.color = 'var(--danger)';
+        msg.textContent = e.message || 'Token generation failed.';
+    } finally {
+        btn.disabled = false;
+    }
+}
+
+function copyLibrarianToken() {
+    const input = document.getElementById('librarian-token-once');
+    if (!input || !input.value) return;
+    input.select();
+    if (navigator.clipboard) navigator.clipboard.writeText(input.value);
+}
+
+/* ── Librarian: writer bot token (dedicated action, §4.1.3) ──────────
+   The writer token is set/cleared ONLY through
+   POST/DELETE /admin/librarian/writer-token. It is never part of
+   saveSettings()'s payload (the generic settings save 400s on it by
+   design) and the stored token is never rendered back — the status
+   line shows username + fingerprint only. */
+async function setLibrarianWriterToken() {
+    const input = document.getElementById('librarian-writer-token');
+    const msg = document.getElementById('librarian-writer-msg');
+    const btn = document.getElementById('librarian-writer-set');
+    if (!input || !msg) return;
+    const token = input.value.trim();
+    if (!token) {
+        msg.style.display = '';
+        msg.style.color = 'var(--danger)';
+        msg.textContent = 'Paste the Media Manager bot token first.';
+        return;
+    }
+    if (btn) btn.disabled = true;
+    try {
+        const res = await fetch('/admin/librarian/writer-token', {
+            method: 'POST', headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({ token })
+        });
+        const data = await res.json().catch(() => ({}));
