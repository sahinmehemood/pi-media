+    from Backend.helper import update_manager as um
+
+    snap = await asyncio.to_thread(um.status_snapshot)
+    snap["running"] = _update_run_state["running"]
+    snap["action"] = _update_run_state["action"]
+    return {"status": "success", "data": snap}
+
+
